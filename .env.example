# Copy this file to .env and fill in your values.
# The Makefile auto-loads .env on every run — no manual sourcing needed.
#
# Format rules (Makefile compatible):
#   KEY=value        ✓ correct
#   KEY="value"      ✗ quotes become part of the value — don't use
#   export KEY=value ✗ 'export' prefix will break parsing — don't use

# API keys for LLM-backed ATS analysis.
# Cerebras is the primary backend (~1M tokens/day free, fast Llama 3.3 70B).
# Groq is the automatic fallback if Cerebras hits its rate limit.
# At least one key must be set for LLM mode; both is recommended.
# When neither is set, NLP (spaCy) is used instead (run: make ats-deps).
CEREBRAS_API_KEY=your_cerebras_api_key_here
GROQ_API_KEY=your_groq_api_key_here
