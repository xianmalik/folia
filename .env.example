# Copy this file to .env and fill in your values.
# The Makefile auto-loads .env on every run — no manual sourcing needed.
#
# Format rules (Makefile compatible):
#   KEY=value        ✓ correct
#   KEY="value"      ✗ quotes become part of the value — don't use
#   export KEY=value ✗ 'export' prefix will break parsing — don't use

# Groq API key — get yours at https://console.groq.com
# When set, `make ats JD=file.txt` automatically uses the Groq LLM backend.
# When not set, spaCy NLP is used instead (requires: make ats-deps).
GROQ_API_KEY=your_groq_api_key_here
