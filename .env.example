# Copy this file to .env and fill in your values.
# The Makefile auto-loads .env on every run — no manual sourcing needed.
#
# Format rules (Makefile compatible):
#   KEY=value        ✓ correct
#   KEY="value"      ✗ quotes become part of the value — don't use
#   export KEY=value ✗ 'export' prefix will break parsing — don't use

# API key for LLM-backed ATS analysis.
# Groq is the backend: openai/gpt-oss-120b is the primary model, with
# meta-llama/llama-4-scout-17b-16e-instruct as the automatic fallback on rate limit.
# Set this key for LLM mode; when unset, NLP (spaCy) is used instead (run: make ats-deps).
GROQ_API_KEY=your_groq_api_key_here
